{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"<p>     WELCOME   </p>      ysweb\u55b5    <p>     \u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9   </p>"},{"location":"changelog/","title":"\u66f4\u65b0\u65e5\u5fd7","text":""},{"location":"changelog/#2026-09-29","title":"2026-09-29","text":"<ul> <li>\u65b0\u589e\u6587\u7ae0\uff1aPython \u57fa\u7840\u7b14\u8bb0</li> <li>\u4fee\u6539\u4e86\u201c\u5173\u4e8e\u6211\u201d\u9875\u9762\u7684\u81ea\u6211\u4ecb\u7ecd</li> </ul>"},{"location":"changelog/#2026-09-20","title":"2026-09-20","text":"<ul> <li>\u7f51\u7ad9\u6b63\u5f0f\u4e0a\u7ebf</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f \uff08\u8fd9\u91cc\u5199\u4f60\u7684\u540d\u5b57\uff09\u3002</p> <p>\u6211\u76ee\u524d\u5728 \uff08\u8fd9\u91cc\u5199\u4f60\u7684\u8eab\u4efd\uff0c\u6bd4\u5982\uff1a\u4e00\u540d\u5b66\u751f / \u4e00\u540d\u7a0b\u5e8f\u5458\uff09\uff0c \u5e73\u65f6\u559c\u6b22 \uff08\u8fd9\u91cc\u5199\u4f60\u7684\u7231\u597d\uff0c\u6bd4\u5982\uff1a\u770b\u7eaa\u5f55\u7247\u3001\u8dd1\u6b65\uff09\u3002</p> <p>\u8fd9\u4e2a\u7f51\u7ad9\u7528\u6765 \uff08\u8fd9\u91cc\u5199\u7528\u9014\uff0c\u6bd4\u5982\uff1a\u8bb0\u5f55\u6211\u7684\u5b66\u4e60\u7b14\u8bb0\uff09\u3002</p>"},{"location":"about/#_2","title":"\u8054\u7cfb\u6211","text":"<ul> <li>\u90ae\u7bb1\uff1a<code>your-email@example.com</code></li> <li>GitHub\uff1a\u4f60\u7684\u4e3b\u9875</li> </ul> <p>\u628a\u4e0a\u9762\u62ec\u53f7\u91cc\u7684\u5185\u5bb9\u6362\u6210\u4f60\u81ea\u5df1\u7684\u4ecb\u7ecd\u5c31\u53ef\u4ee5\u4e86\uff0c\u5199\u6cd5\u53ef\u4ee5\u76f4\u63a5\u53c2\u8003 \u793a\u4f8b\u8bfe\u7a0b\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u5b66\u8fc7\u7684\u8bfe\u7a0b\u548c\u6574\u7406\u7684\u7b14\u8bb0\uff0c\u70b9\u6807\u9898\u5c31\u80fd\u6253\u5f00\u5bf9\u5e94\u6587\u7ae0\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\uff1a\u4e00\u7bc7\u6587\u7ae0\u7684\u6807\u51c6\u5199\u6cd5 \u2014\u2014 \u4e0d\u77e5\u9053\u6587\u7ae0\u8be5\u600e\u4e48\u5199\uff1f\u5148\u770b\u8fd9\u4e00\u7bc7</li> <li>Python \u57fa\u7840\u7b14\u8bb0 \u2014\u2014 \u5360\u4f4d\u6587\u7ae0\uff0c\u63d0\u7eb2\u5df2\u5217\u597d\uff0c\u5185\u5bb9\u5f85\u8865\u5145</li> <li>(\u4ee5\u540e\u6bcf\u5199\u4e00\u7bc7\u65b0\u6587\u7ae0\uff0c\u5c31\u5728\u8fd9\u4e2a\u5217\u8868\u91cc\u52a0\u4e00\u884c)</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\uff1a\u4e00\u7bc7\u6587\u7ae0\u7684\u6807\u51c6\u5199\u6cd5","text":"<p>\u8fd9\u7bc7\u6587\u7ae0\u662f\u7ed9\u4f60\u5f53\u6a21\u677f\u7528\u7684\u3002 \u4ee5\u540e\u5199\u65b0\u6587\u7ae0\u65f6\uff0c \u628a\u8fd9\u4efd\u6587\u4ef6\u590d\u5236\u4e00\u4efd\u3001\u6539\u4e2a\u540d\u5b57\uff08\u6bd4\u5982 <code>python-notes.md</code>\uff09\uff0c\u518d\u66ff\u6362\u91cc\u9762\u7684\u5185\u5bb9\u5c31\u884c\u3002</p>"},{"location":"course/example/#_2","title":"\u4e00\u3001\u5f00\u5934\u5148\u5199\u4e00\u53e5\u8bdd\u6458\u8981","text":"<p>\u7528\u4e00\u884c\u5b57\u8bf4\u660e\u8fd9\u7bc7\u6587\u7ae0\u8bb2\u4ec0\u4e48\uff0c\u8bfb\u8005\u4e09\u79d2\u949f\u5c31\u77e5\u9053\u8981\u4e0d\u8981\u5f80\u4e0b\u770b\u3002</p>"},{"location":"course/example/#_3","title":"\u4e8c\u3001\u6b63\u6587\u7528\u5c0f\u6807\u9898\u5206\u5c42","text":""},{"location":"course/example/#1","title":"1. \u4e00\u7ea7\u5c0f\u8282\u7528\u4e24\u4e2a\u4e95\u53f7 <code>##</code>","text":"<p>\u6b63\u6587\u76f4\u63a5\u5199\u5c31\u884c\u3002\u6362\u884c\u8981\u7a7a\u4e00\u884c\uff0cMarkdown \u624d\u4f1a\u5206\u6210\u4e24\u4e2a\u6bb5\u843d\u3002</p>"},{"location":"course/example/#2","title":"2. \u9700\u8981\u66f4\u7ec6\u7684\u5206\u5c42\uff0c\u7528\u4e09\u4e2a\u4e95\u53f7 <code>###</code>","text":"<p>\u6bd4\u5982\u8fd9\u91cc\u3002</p>"},{"location":"course/example/#_4","title":"\u4e09\u3001\u5e38\u7528\u5199\u6cd5\u901f\u67e5","text":"<p>\u52a0\u7c97 \u7528\u4e24\u4e2a\u661f\u53f7\u5305\u8d77\u6765\uff0c\u659c\u4f53 \u7528\u4e00\u4e2a\u661f\u53f7\u5305\u8d77\u6765\u3002</p> <p>\u9700\u8981\u5f3a\u8c03\u4e00\u53e5\u8bdd\u65f6\uff0c\u53ef\u4ee5\u8fd9\u6837\u5199\uff1a</p> <p>\u8fd9\u662f\u4e00\u6bb5\u5f15\u7528\u6587\u5b57\uff0c\u5de6\u8fb9\u4f1a\u51fa\u73b0\u4e00\u6761\u7ad6\u7ebf\u3002</p>"},{"location":"course/example/#_5","title":"\u65e0\u5e8f\u6e05\u5355","text":"<ul> <li>\u7b2c\u4e00\u70b9</li> <li>\u7b2c\u4e8c\u70b9</li> <li>\u60f3\u7f29\u8fdb\u5c31\u5728\u524d\u9762\u591a\u6572\u4e24\u4e2a\u7a7a\u683c</li> </ul>"},{"location":"course/example/#_6","title":"\u6709\u5e8f\u6e05\u5355","text":"<ol> <li>\u7b2c\u4e00\u6b65</li> <li>\u7b2c\u4e8c\u6b65</li> <li>\u7b2c\u4e09\u6b65</li> </ol>"},{"location":"course/example/#_7","title":"\u63d2\u5165\u94fe\u63a5","text":"<p>\u70b9\u8fd9\u91cc\u53ef\u4ee5\u8df3\u5230\u8bfe\u7a0b\u9996\u9875\uff0c\u6216\u8005\u5199\u5b8c\u6574\u7684\u7f51\u5740 \u767e\u5ea6\u3002</p>"},{"location":"course/example/#_8","title":"\u63d2\u5165\u4ee3\u7801","text":"<p>\u4e00\u5c0f\u6bb5\u4ee3\u7801\uff0c\u7528\u4e00\u5bf9\u53cd\u5f15\u53f7\u5305\u4f4f\uff0c\u6bd4\u5982 <code>print(\"\u4f60\u597d\")</code>\u3002</p> <p>\u6574\u5757\u4ee3\u7801\uff0c\u7528\u4e09\u4e2a\u53cd\u5f15\u53f7\u8d77\u5934\u7ed3\u5c3e\uff0c\u5e76\u5199\u4e0a\u8bed\u8a00\u540d\uff1a</p> <pre><code>def hello(name):\n    print(f\"\u4f60\u597d\uff0c{name}\")\n\nhello(\"\u4e16\u754c\")\n</code></pre>"},{"location":"course/example/#_9","title":"\u63d2\u5165\u8868\u683c","text":"\u9879\u76ee \u8bf4\u660e \u96be\u5ea6 Markdown \u5199\u4f5c\u8bed\u6cd5 \u7b80\u5355 MkDocs \u751f\u6210\u7f51\u7ad9 \u7b80\u5355"},{"location":"course/example/#_10","title":"\u63d2\u5165\u63d0\u793a\u6846\uff08\u8fd9\u4e2a\u4e3b\u9898\u7279\u6709\uff0c\u5f88\u597d\u7528\uff09","text":"<p>\u5c0f\u63d0\u793a</p> <p>\u8fd9\u91cc\u5199\u63d0\u793a\u5185\u5bb9\u3002\u5f00\u5934\u7684 <code>!!! note</code> \u8868\u793a\"\u63d0\u793a\"\uff0c \u6362\u6210 <code>!!! tip</code> \u662f\u6280\u5de7\uff0c<code>!!! warning</code> \u662f\u8b66\u544a\uff0c<code>!!! danger</code> \u662f\u5371\u9669\u3002</p>"},{"location":"course/example/#_11","title":"\u56db\u3001\u7ed3\u5c3e\u5199\u70b9\u603b\u7ed3","text":"<p>\u6587\u7ae0\u6700\u540e\u53ef\u4ee5\u8bf4\u4e00\u53e5\"\u8fd9\u7bc7\u5c31\u5230\u8fd9\u91cc\"\uff0c\u6216\u8005\u5217\u51fa\u4e0b\u6b21\u8981\u8bb2\u7684\u5185\u5bb9\u3002</p>"},{"location":"course/python-notes/","title":"Python \u57fa\u7840\u7b14\u8bb0","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u5360\u4f4d\u6587\u7ae0</p> <p>\u5185\u5bb9\u8fd8\u662f\u7a7a\u7684\uff0c\u5148\u628a\u63d0\u7eb2\u5217\u5728\u8fd9\u91cc\u3002\u4ee5\u540e\u6bcf\u5b66\u5b8c\u4e00\u5757\uff0c\u5c31\u628a\u5bf9\u5e94\u7684\u7ae0\u8282\u8865\u4e0a\uff0c \u628a <code>- [ ]</code> \u6539\u6210 <code>- [x]</code> \u8868\u793a\u5df2\u5b8c\u6210\u3002\u5199\u6cd5\u53ef\u4ee5\u53c2\u8003 \u793a\u4f8b\u8bfe\u7a0b\u3002</p>"},{"location":"course/python-notes/#_1","title":"\u4e00\u3001\u73af\u5883\u4e0e\u5de5\u5177","text":"<ul> <li>[ ] \u5b89\u88c5 Python \u5e76\u9a8c\u8bc1\u7248\u672c</li> <li>[ ] \u7528 VS Code \u5199\u7b2c\u4e00\u4e2a\u7a0b\u5e8f</li> <li>[ ] \u865a\u62df\u73af\u5883\u4e0e pip \u5b89\u88c5\u7b2c\u4e09\u65b9\u5e93</li> </ul>"},{"location":"course/python-notes/#_2","title":"\u4e8c\u3001\u57fa\u7840\u8bed\u6cd5","text":"<ul> <li>[ ] \u53d8\u91cf\u4e0e\u6570\u636e\u7c7b\u578b\uff08\u6570\u5b57\u3001\u5b57\u7b26\u4e32\u3001\u5e03\u5c14\uff09</li> <li>[ ] \u6761\u4ef6\u5224\u65ad <code>if / elif / else</code></li> <li>[ ] \u5faa\u73af <code>for</code> \u4e0e <code>while</code></li> <li>[ ] \u51fd\u6570\u4e0e\u53c2\u6570</li> <li>[ ] \u5217\u8868\u3001\u5143\u7ec4\u3001\u5b57\u5178\u3001\u96c6\u5408</li> </ul>"},{"location":"course/python-notes/#_3","title":"\u4e09\u3001\u5e38\u7528\u4ee3\u7801\u7247\u6bb5","text":"<p>\u8bfb\u6587\u4ef6\uff08\u6bcf\u884c\u53bb\u6389\u672b\u5c3e\u6362\u884c\uff09\uff1a</p> <pre><code>with open(\"data.txt\", encoding=\"utf-8\") as f:\n    for line in f:\n        print(line.strip())\n</code></pre> <p>\u5199\u6587\u4ef6\uff1a</p> <pre><code>with open(\"out.txt\", \"w\", encoding=\"utf-8\") as f:\n    f.write(\"\u4f60\u597d\uff0c\u4e16\u754c\\n\")\n</code></pre>"},{"location":"course/python-notes/#_4","title":"\u56db\u3001\u5f85\u8865\u5145","text":"<ul> <li>[ ] \u9762\u5411\u5bf9\u8c61\uff1a\u7c7b\u4e0e\u5bf9\u8c61</li> <li>[ ] \u5f02\u5e38\u5904\u7406 <code>try / except</code></li> <li>[ ] \u5e38\u7528\u6807\u51c6\u5e93\uff08<code>os</code>\u3001<code>json</code>\u3001<code>datetime</code>\uff09</li> <li>[ ] \u5c0f\u9879\u76ee\u7ec3\u4e60</li> </ul> <p>\u6700\u540e\u66f4\u65b0\uff1a\u5f85\u8865\u5145</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u6b22\u8fce\u4ea4\u6362\u53cb\u94fe\uff0c\u4e0b\u9762\u4e24\u4e2a\u662f\u5360\u4f4d\u793a\u4f8b\uff0c\u7b49\u4f60\u6709\u4e86\u771f\u5b9e\u94fe\u63a5\u518d\u66ff\u6362\u6389\u3002</p> <ul> <li>\u793a\u4f8b\u7f51\u7ad9 A \u2014\u2014 \u4e00\u53e5\u8bdd\u4ecb\u7ecd\u8fd9\u4e2a\u7f51\u7ad9</li> <li>\u793a\u4f8b\u7f51\u7ad9 B \u2014\u2014 \u4e00\u53e5\u8bdd\u4ecb\u7ecd\u8fd9\u4e2a\u7f51\u7ad9</li> </ul>"},{"location":"friends/#_2","title":"\u600e\u4e48\u6539\u6210\u6211\u81ea\u5df1\u7684\u53cb\u94fe","text":"<p>\u5728 <code>docs/friends/index.md</code> \u6587\u4ef6\u91cc\uff0c\u628a\u4e0a\u9762\u4e24\u884c\u6539\u6210\u8fd9\u6837\u5c31\u884c\uff1a</p> <pre><code>- [\u670b\u53cb\u7684\u7f51\u7ad9\u540d\u5b57](https://\u670b\u53cb\u7684\u7f51\u5740) \u2014\u2014 \u4e00\u53e5\u8bdd\u4ecb\u7ecd\n</code></pre>"}]}